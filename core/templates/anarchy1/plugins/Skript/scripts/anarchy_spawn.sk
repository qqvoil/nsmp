# ==============================================================================
# NeverSMP — Anarchy Spawn, PvP-Arena & Auto-Mine System
# ==============================================================================

options:
    spawn_world: "world"
    spawn_x: 0.5
    spawn_z: 0.5
    spawn_yaw: 0.0
    spawn_pitch: 0.0
    
    # Радиус безопасной зоны спавна
    spawn_radius: 50
    # Радиус PvP-арены вокруг спавна
    arena_radius: 120
    # Высота входа в PvP-арену (ниже этой высоты начинается арена)
    arena_max_y: 85
    
    arena_max_y: 85

# ==============================================================================
# КОМАНДЫ: /spawn и /mine
# ==============================================================================

command /spawn:
    trigger:
        if {combat_tagged::%player%} is set:
            send "&#aa00aa&l! &fВы не можете телепортироваться во время боя!" to player
            stop
        send "&#aa00aa&l! &fТелепортация через &#e056fd3 сек&f. Не двигайтесь!" to player
        set {_start_loc} to player's location
        set {_count} to 3
        while {_count} > 0:
            wait 1 second
            if distance between player's location and {_start_loc} > 0.5:
                send "&#aa00aa&l! &fТелепортация отменена, вы сдвинулись с места!" to player
                stop
            if {combat_tagged::%player%} is set:
                send "&#aa00aa&l! &fТелепортация отменена из-за начала боя!" to player
                stop
            subtract 1 from {_count}
        set {_target} to location of highest solid block at location({@spawn_x}, 0, {@spawn_z}, world({@spawn_world}))
        add 1 to y-coord of {_target}
        set yaw of {_target} to {@spawn_yaw}
        set pitch of {_target} to {@spawn_pitch}
        teleport player to {_target}
        send "&#aa00aa&l! &fВы успешно телепортированы на спавн!" to player
        play sound "entity.enderman.teleport" at player to player


