# ==============================================================================
# NeverSMP — Hardcore DeathBan & Revive Mechanics
# ==============================================================================

options:
    # Длительность бана после смерти (в секундах: 86400 = 24 часа)
    deathban_duration: 86400
    deathban_duration_text: "24 часа"
    
    # Стоимость возрождения токенами
    revive_cost_tokens: 500
    
    spawn_world: "world"
    spawn_x: 0.5
    spawn_y: 80.0
    spawn_z: 0.5

# ==============================================================================
# СОБЫТИЕ: СМЕРТЬ НА ХАРДКОРЕ -> БАН И КИК В ЛОББИ
# ==============================================================================

on death of player:
    if victim is op:
        stop
    if victim has permission "neversmp.hardcore.bypass":
        stop
        
    set {_loc} to victim's location
    set {_x} to round(x-coord of {_loc})
    set {_y} to round(y-coord of {_loc})
    set {_z} to round(z-coord of {_loc})
    set {_now} to now's unix timestamp
    set {_unban_time} to {_now} + {@deathban_duration}
    
    # Запись времени бана и координат
    set {hardcore_deathban::%victim's uuid%} to {_unban_time}
    set {hardcore_death_loc::%victim's uuid%} to {_loc}
    set {hardcore_dead_name::%victim's uuid%} to victim's name
    set {hardcore_dead_by_name::%victim's name%} to victim's uuid
    
    # Оповещение на весь сервер
    broadcast "&8&m--------------------------------------------------"
    broadcast "&c&l☠ ГИБЕЛЬ НА ХАРДКОРЕ!"
    broadcast "&fИгрок &e%victim's name% &fпогиб и заблокирован на &c{@deathban_duration_text}&f!"
    broadcast "&7Координаты гибели: &eX: %{_x}%, Y: %{_y}%, Z: %{_z}%"
    broadcast "&8&m--------------------------------------------------"
    
    # Выполнение консольного бана в TempBan / Essentials для надёжности
    make console execute command "tempban ban %victim's name% {@deathban_duration} Смерть_на_Хардкоре"
    make console execute command "tempban %victim's name% 24h &cСмерть на Хардкоре"
    
    # Задержка 1 тик для обработки дропа вещей и кик с причиной
    wait 1 tick
    kick victim due to "&c&lNeverSMP — ХАРДКОР%nl%%nl%&fВы погибли на сервере &cHardcore&f!%nl%&7Координаты гибели: &eX: %{_x}%, Y: %{_y}%, Z: %{_z}%%nl%&7Срок бана: &c{@deathban_duration_text}%nl%%nl%&aТиммейты могут воскресить вас: &e/revive %victim's name%%nl%&aРазбан на сайте: &ddonate.neversmp.ru"

# ==============================================================================
# ПРОВЕРКА ПРИ ВХОДЕ НА ХАРДКОР
# ==============================================================================

on connect:
    if player is op:
        stop
    if player has permission "neversmp.hardcore.bypass":
        stop
        
    if {hardcore_deathban::%player's uuid%} is set:
        set {_now} to now's unix timestamp
        set {_expire} to {hardcore_deathban::%player's uuid%}
        
        if {_now} >= {_expire}:
            # Срок бана истёк — снимаем бан
            delete {hardcore_deathban::%player's uuid%}
            delete {hardcore_death_loc::%player's uuid%}
            make console execute command "tempban unban %player's name%"
            make console execute command "pardon %player's name%"
        else:
            # Бан ещё действует — вычисляем оставшееся время
            set {_diff} to {_expire} - {_now}
            set {_hours} to floor({_diff} / 3600)
            set {_mins} to floor(mod({_diff}, 3600) / 60)
            set {_secs} to mod({_diff}, 60)
            
            kick player due to "&c&lNeverSMP — ХАРДКОР%nl%%nl%&fВы заблокированы из-за гибели на Хардкоре!%nl%&7До разбана осталось: &e%{_hours}% ч. %{_mins}% мин. %{_secs}% сек.%nl%%nl%&aТиммейты могут воскресить вас: &e/revive %player's name%%nl%&aРазбан на сайте: &ddonate.neversmp.ru"

# ==============================================================================
# КОМАНДЫ ВОСКРЕШЕНИЯ ТИММЕЙТОВ: /revive <ник>
# ==============================================================================

command /revive [<text>]:
    aliases: /воскресить, /resurrect
    trigger:
        if arg-1 is not set:
            send "&8&m--------------------------------------------------" to player
            send "&6&l⚔ NeverSMP — Воскрешение на Хардкоре" to player
            send "&e/revive <ник_игрока> &7— воскресить погибшего тиммейта" to player
            send "&7Требуется: &eТотем бессмертия &7или &e{@revive_cost_tokens} токенов" to player
            send "&8&m--------------------------------------------------" to player
            stop
            
        set {_target_name} to arg-1
        set {_target_uuid} to {hardcore_dead_by_name::%{_target_name}%}
        
        if {_target_uuid} is not set:
            # Попробуем найти uuid среди всех забаненных
            loop {hardcore_deathban::*}:
                if {hardcore_dead_name::%loop-index%} is {_target_name}:
                    set {_target_uuid} to loop-index
                    
        if {_target_uuid} is not set:
            if {hardcore_deathban::%{_target_name}%} is set:
                set {_target_uuid} to {_target_name}
                
        if {_target_uuid} is not set:
            send "&cИгрок &e%{_target_name}% &cне числится среди погибших на Хардкоре!" to player
            stop
            
        if {hardcore_deathban::%{_target_uuid}%} is not set:
            send "&aИгрок &e%{_target_name}% &aуже разбанен и жив!" to player
            stop
            
        # Способ 1: Воскрешение Тотемом бессмертия из рук
        if player's held item is totem of undying:
            remove 1 totem of undying from player's inventory
            
            delete {hardcore_deathban::%{_target_uuid}%}
            delete {hardcore_death_loc::%{_target_uuid}%}
            make console execute command "tempban unban %{_target_name}%"
            make console execute command "pardon %{_target_name}%"
            
            broadcast "&8&m--------------------------------------------------"
            broadcast "&a&l✦ РИТУАЛ ВОСКРЕШЕНИЯ!"
            broadcast "&fИгрок &e%player's name% &fпожертвовал &eТотем Бессмертия &fи воскресил &a%{_target_name}%&f!"
            broadcast "&8&m--------------------------------------------------"
            play sound "ui.toast.challenge_complete" at player to player
            stop
            
        # Способ 2: Воскрешение за токены
        set {_tokens} to placeholder "playerpoints_points" from player parsed as integer
        if {_tokens} >= {@revive_cost_tokens}:
            make console execute command "p take %player's name% {@revive_cost_tokens}"
            
            delete {hardcore_deathban::%{_target_uuid}%}
            delete {hardcore_death_loc::%{_target_uuid}%}
            make console execute command "tempban unban %{_target_name}%"
            make console execute command "pardon %{_target_name}%"
            
            broadcast "&8&m--------------------------------------------------"
            broadcast "&a&l✦ ВОСКРЕШЕНИЕ ЗА ТОКЕНЫ!"
            broadcast "&fИгрок &e%player's name% &fвоскресил &a%{_target_name}% &fза &e{@revive_cost_tokens} токенов&f!"
            broadcast "&8&m--------------------------------------------------"
            play sound "ui.toast.challenge_complete" at player to player
            stop
            
        send "&cДля воскрешения возьмите в руку &eТотем Бессмертия &cили накопите &e{@revive_cost_tokens} токенов &c(У вас: %{_tokens}%)." to player

# Команда админа для сброса бана смерти
command /unbanhardcore <text>:
    permission: op
    trigger:
        set {_name} to arg-1
        set {_uuid} to {hardcore_dead_by_name::%{_name}%}
        if {_uuid} is set:
            delete {hardcore_deathban::%{_uuid}%}
            delete {hardcore_death_loc::%{_uuid}%}
        delete {hardcore_deathban::%{_name}%}
        make console execute command "tempban unban %{_name}%"
        make console execute command "pardon %{_name}%"
        send "&aСмерть-бан игрока %{_name}% успешно сброшен!" to player
