# ==============================================================================
# NeverSMP — Hardcore DeathBan & Revive Mechanics (Global Sync)
# ==============================================================================

options:
    deathban_duration: 86400
    revive_cost_tokens: 500

# ==============================================================================
# СОБЫТИЕ: СМЕРТЬ НА ХАРДКОРЕ -> ГЛОБАЛЬНЫЙ БАН В LUCKPERMS
# ==============================================================================

on death of player:
    if victim is op:
        stop
    if victim has permission "neversmp.hardcore.bypass":
        stop
        
    set {_loc} to victim's location
    set {_x} to round(x-coord of {_loc})
    set {_y} to round(y-coord of {_loc})
    set {_z} to round(z-coord of {_loc})
    
    # Выдаем глобальное право hardcore.dead через LuckPerms. 
    # Так как БД общая, бан мгновенно синхронизируется на всех серверах!
    execute console command "lp user %victim's name% permission set hardcore.dead true"
    
    # Оповещение на весь сервер
    broadcast "&8&m--------------------------------------------------"
    broadcast "&c&l☠ ГИБЕЛЬ НА ХАРДКОРЕ!"
    broadcast "&fИгрок &e%victim's name% &fпогиб на поле боя!"
    broadcast "&7Координаты гибели: &eX: %{_x}%, Y: %{_y}%, Z: %{_z}%"
    broadcast "&8&m--------------------------------------------------"
    
    # Кик игрока с сервера с подробным экраном
    wait 1 tick
    execute console command "kick %victim's name% §c§lNeverSMP — ХАРДКОР\n\n§fВы погибли на сервере §cHardcore§f!\n§7Координаты гибели: §eX: %{_x}%, Y: %{_y}%, Z: %{_z}%\n§7Срок бана: §cДо следующего вайпа\n\n§aТиммейты могут воскресить вас: §e/revive %victim's name%\n§aРазбан на сайте: §ddonate.neversmp.ru"

# ==============================================================================
# ПРОВЕРКА ПРИ ВХОДЕ НА ХАРДКОР (РАБОТАЕТ НА ЛЮБОМ СЕРВЕРЕ)
# ==============================================================================

on connect:
    if player is op:
        stop
    if player has permission "neversmp.hardcore.bypass":
        stop
        
    # Если право есть, игрок откидывается ещё до входа в мир
    if player has permission "hardcore.dead":
        kick player due to "§c§lNeverSMP — ХАРДКОР\n\n§fВы заблокированы из-за гибели на Хардкоре!\n§7Срок бана: §cДо следующего вайпа\n\n§aТиммейты могут воскресить вас: §e/revive %player's name%\n§aРазбан на сайте: §ddonate.neversmp.ru"

# ==============================================================================
# КОМАНДЫ ВОСКРЕШЕНИЯ ТИММЕЙТОВ: /revive <ник>
# ==============================================================================

command /revive [<text>]:
    aliases: /воскресить, /resurrect
    trigger:
        if arg-1 is not set:
            send "&8&m--------------------------------------------------" to player
            send "&6&l⚔ NeverSMP — Воскрешение на Хардкоре" to player
            send "&e/revive <ник_игрока> &7— воскресить погибшего тиммейта" to player
            send "&7Требуется: &eТотем бессмертия &7в руке" to player
            send "&8&m--------------------------------------------------" to player
            stop
            
        set {_target_name} to arg-1
        
        # Проверяем, действительно ли игрок мертв через проверку прав
        # (Можно добавить проверку игрока онлайн/офлайн через LP)
        
        # Способ 1: Воскрешение Тотемом бессмертия из рук
        if player's tool is totem of undying:
            remove 1 totem of undying from player's inventory
            
            # Снимаем право. Изменение мгновенно улетает в базу и игрок может зайти.
            execute console command "lp user %{_target_name}% permission unset hardcore.dead"
            
            broadcast "&8&m--------------------------------------------------"
            broadcast "&a&l✦ РИТУАЛ ВОСКРЕШЕНИЯ!"
            broadcast "&fИгрок &e%player's name% &fпожертвовал &eТотем Бессмертия &fи воскресил &a%{_target_name}%&f!"
            broadcast "&8&m--------------------------------------------------"
            play sound "ui.toast.challenge_complete" at player to player
            stop
            
        send "&cДля воскрешения возьмите в руку &eТотем Бессмертия&c!" to player

# ==============================================================================
# КОМАНДЫ АДМИНА И ОГРАНИЧЕНИЯ
# ==============================================================================

# Команда админа для сброса бана смерти
command /unbanhardcore <text>:
    permission: op
    trigger:
        set {_name} to arg-1
        execute console command "lp user %{_name}% permission unset hardcore.dead"
        send "&aСмерть-бан игрока %{_name}% успешно сброшен (право hardcore.dead удалено)!" to player
