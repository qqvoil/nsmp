# ============================================
# ЗАЩИТА ЛОББИ + КОМПАС + БЛОКИРОВКА СЛОТА 0
# ============================================

# Запрет на установку блоков
on place:
    if player's world is "world":
        cancel the event
        send action bar "&cНельзя ставить блоки в лобби!" to player

# Запрет на разрушение блоков
on break:
    if player's world is "world":
        cancel the event
        send action bar "&cНельзя ломать блоки в лобби!" to player

# Запрет на взаимодействие с блоками
on rightclick:
    if clicked block is set:
        if player's world is "world":
            cancel the event

# ============================================
# ВЫДАЧА КОМПАСА В СЛОТ 0
# ============================================

function giveLobbyCompass(p: player):
    if {_p}'s world is "world":
        set {_c} to recovery compass named "&6&lВЫБОР РЕЖИМА &7(ПКМ)" with lore "&7Нажмите правой кнопкой мыши," and "&7чтобы открыть меню серверов &eNeverSMP"
        enchant {_c} with unbreaking 1
        set slot 0 of {_p}'s inventory to {_c}

on join:
    wait 2 ticks
    teleport player to spawn of world("world")
    giveLobbyCompass(player)
    wait 2 seconds
    giveLobbyCompass(player)

# Периодическая проверка наличия компаса в лобби
every 3 seconds:
    loop all players:
        if loop-player's world is "world":
            if slot 0 of loop-player's inventory is not recovery compass:
                giveLobbyCompass(loop-player)

# Выдача при выполнении команды (в т.ч. после прохождения верификации)
on command:
    if player's world is "world":
        wait 5 ticks
        if slot 0 of player's inventory is not recovery compass:
            giveLobbyCompass(player)

# Открытие меню по клику на компас
on rightclick:
    if player's held item is recovery compass:
        cancel the event
        make player execute command "dm open server_selector"

# ============================================
# БЛОКИРОВКА СЛОТА 0 (НЕЛЬЗЯ ПЕРЕМЕСТИТЬ)
# ============================================

# Запрет на клик по слоту 0 (перемещение, перетаскивание)
on inventory click:
    if event-slot = 0:
        cancel the event
        send action bar "&cЭтот слот заблокирован!" to player

# Защита от выбрасывания (клавиша Q)
on drop:
    if event-item is recovery compass:
        cancel the event
        send action bar "&cНельзя выбросить компас меню!" to player

# Запрет смены в левую руку (клавиша F)
on swap hand items:
    if player's world is "world":
        cancel the event