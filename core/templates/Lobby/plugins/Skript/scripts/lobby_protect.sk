# ============================================
# ЗАЩИТА ЛОББИ + КОМПАС + БЛОКИРОВКА СЛОТА 0
# ============================================

# Запрет на установку блоков
on place:
    if player's world is "world":
        cancel the event
        send action bar "&cНельзя ставить блоки!" to player

# Запрет на разрушение блоков
on break:
    if player's world is "world":
        cancel the event
        send action bar "&cНельзя ломать блоки!" to player

# Запрет на взаимодействие с блоками
on rightclick:
    if clicked block is set:
        if player's world is "world":
            cancel the event
            send action bar "&cНельзя взаимодействовать с блоками!" to player

# ============================================
# ВЫДАЧА КОМПАСА В СЛОТ 0
# ============================================

on join:
    wait 2 ticks
    teleport player to spawn of world("world")
    clear player's inventory
    set {_c} to recovery compass named "&d&lMENU" with lore "&cАнархия (без вайпов)" and "&bСМП (с вайпами)"
    enchant {_c} with unbreaking 1
    set slot 0 of player's inventory to {_c}

# Открытие меню по клику на компас
on rightclick:
    if player's held item is recovery compass named "&d&lMENU":
        cancel the event
        make player execute command "dmenu open server_selector"

# ============================================
# БЛОКИРОВКА СЛОТА 0 (НЕЛЬЗЯ ПЕРЕМЕСТИТЬ)
# ============================================

# Запрет на клик по слоту 0 (перемещение, перетаскивание)
on inventory click:
    if event-slot = 0:
        cancel the event
        send action bar "&cЭтот слот заблокирован!" to player

# Защита от выбрасывания (клавиша Q)
on drop:
    if event-item is recovery compass named "&d&lMENU":
        cancel the event
        send action bar "&cНельзя выбросить компас!" to player